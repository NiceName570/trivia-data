  "sections": [
    {
      "title": "CAREER RECORDS AND LEGENDS (regular season unless stated)",
      "facts": [
        {
          "source": "passing-career",
          "text": "Career passing yards: Tom Brady 89,214; Drew Brees 80,358; Peyton Manning 71,940; Brett Favre 71,838 (top four)."
        },
        {
          "source": "brady-titles",
          "text": "Tom Brady won a record seven Super Bowls: six with New England Patriots, one with Tampa Bay Buccaneers (LV). He earned five Super Bowl MVP awards."
        },
        {
          "source": "rice",
          "text": "Jerry Rice: career receptions 1,549; receiving yards 22,895; receiving TD 197; total TD 208. Teams: 49ers, Raiders, Seahawks. College: Mississippi Valley State; 1985 draft pick 16. Three Super Bowl wins; XXIII MVP."
        },
        {
          "source": "smith",
          "text": "Emmitt Smith: career rushing yards 18,355; rushing TD 164. Teams: Cowboys, Cardinals. Dallas drafted him 17th in 1990 from Florida. 1993 NFL MVP; XXVIII MVP; four rushing titles (1991, 1992, 1993, 1995)."
        },
        {
          "source": "sacks-career",
          "text": "Official career sacks: Bruce Smith 200; Reggie White 198; Kevin Greene 160; Julius Peppers 159.5; Chris Doleman 150.5 (top five)."
        },
        {
          "source": "krause",
          "text": "Career interceptions leader: Paul Krause 81; teams Washington and Minnesota; safety; Hall of Fame 1998. Emlen Tunnell had 79."
        },
        {
          "source": "vinatieri",
          "text": "Career scoring leader: Adam Vinatieri 2,673 points; career field goals 599. Teams Patriots and Colts; four Super Bowl wins (three New England, one Indianapolis); Hall of Fame class 2026."
        },
        {
          "source": "manning",
          "text": "Peyton Manning: record five AP NFL MVP awards (2003, 2004, 2008, 2009, 2013); 1998 first overall pick by Colts; college Tennessee; teams Colts and Broncos; Super Bowl XLI and 50 wins; Hall of Fame 2021."
        },
        {
          "source": "shula",
          "text": "Don Shula: career coaching wins 347 including playoffs; coached Baltimore Colts 1963-1969 and Miami Dolphins 1970-1995; two Super Bowl wins (VII, VIII); Hall of Fame 1997."
        }
      ]
    },
    {
      "title": "SEASON RECORDS AND SINGLE-GAME LANDMARKS (retain the specified year)",
      "facts": [
        {
          "source": "manning",
          "text": "Single-season passing yards 5,477 and passing TD 55: Peyton Manning, Denver Broncos, 2013. His 2004 passing-TD mark of 49 is an older record."
        },
        {
          "source": "season-records",
          "text": "Single-season rushing yards 2,105: Eric Dickerson, Los Angeles Rams, 1984."
        },
        {
          "source": "season-records",
          "text": "Single-season receiving yards 1,964: Calvin Johnson, Detroit Lions, 2012."
        },
        {
          "source": "season-records",
          "text": "Single-season receptions 149: Michael Thomas, New Orleans Saints, 2019."
        },
        {
          "source": "patriots-2007",
          "text": "Single-season receiving TD 23: Randy Moss, New England Patriots, 2007; surpassed Jerry Rice's 22 in 1987. Tom Brady threw 50 TD in 2007, later surpassed by Manning's 55."
        },
        {
          "source": "garrett-record",
          "text": "Single-season official sacks 23: Myles Garrett, Cleveland Browns, 2025. He broke the 22.5 shared by Michael Strahan (Giants, 2001) and T.J. Watt (Steelers, 2021), sacking Joe Burrow on January 4, 2026. Official sacks date from 1982."
        },
        {
          "source": "little-record",
          "text": "Longest regular-season field goal: Cam Little, Jacksonville Jaguars, 68 yards against Las Vegas Raiders (2025 season). Preseason kicks are a separate category."
        },
        {
          "source": "single-games",
          "text": "Single-game passing yards 554: Norm Van Brocklin, Los Angeles Rams vs New York Yanks, September 28, 1951."
        },
        {
          "source": "single-games",
          "text": "Single-game rushing yards 296: Adrian Peterson, Minnesota Vikings vs San Diego Chargers, November 4, 2007; three rushing TD."
        },
        {
          "source": "single-games",
          "text": "Single-game receiving yards 336: Willie 'Flipper' Anderson, Los Angeles Rams vs New Orleans Saints, November 26, 1989 (includes overtime)."
